node_modules

# Runtime data written by the bot — kept out of git for privacy.
# Ignore the dir's CONTENTS (not the dir itself) so the .js helpers
# (cache.js, channels.js) can be re-included; a trailing-slash ignore
# on the directory would make re-inclusion impossible.
/modules/data/*
!/modules/data/*.js

# Runtime judiciary case data
/modules/judiciary/data/

# Uploaded / generated images (clan flags, emblems, server logos)
/modules/images/
