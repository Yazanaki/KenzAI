# ============================================================
# KenzAI environment template — copy this to ".env" and fill in.
# Lines starting with # are optional/off — uncomment and set only
# the features you use. Never commit your real .env (it's gitignored).
# ============================================================

# ---- REQUIRED: Discord bot ----
# From the Discord Developer Portal (https://discord.com/developers/applications)
#   TOKEN     = Bot tab -> Token (if lost, click "Reset Token" for a new one)
#   CLIENT_ID = General Information -> Application ID (this is NOT a secret)
TOKEN=
CLIENT_ID=

# ---- MySQL (optional — leave MYSQL_ENABLED=false to use JSON storage only) ----
MYSQL_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kenzai
DB_USER=
DB_PASSWORD=
# Rollout flags (see modules/database/dbConfig.js for the full staged rollout):
DB_DUAL_WRITE=false
DB_JSON_WRITES_DISABLED=false
DB_READ_MEMBERS=json
DB_READ_CLANS=json
DB_READ_EMPIRE_REGISTRY=json
DB_READ_EXTRAS=json

# ---- Optional: Minecraft bot control (/mcbot) ----
# MCBOT_VPS_URL=
# MCBOT_API_KEY=

# ---- Optional: cosmetics internal endpoint (for the launcher/API) ----
# COSMETICS_INTERNAL_SECRET=
# COSMETICS_INTERNAL_HOST=127.0.0.1
# COSMETICS_INTERNAL_PORT=

# ---- Optional: Patreon / monetization ----
# PATREON_URL=
# PATREON_ACCESS_TOKEN=
# PATREON_CAMPAIGN_ID=
# PATREON_WEBHOOK_SECRET=
# PATREON_POLL_INTERVAL_MS=
# PATREON_TIER_STANDARD_ID=
# PATREON_TIER_PREMIUM_ID=
# PATREON_TIER_VIP_ID=
# STRIPE_WEBHOOK_SECRET=
# WEBHOOK_PORT=
# REQUIRE_SUBSCRIPTION=
# TIER_STANDARD_LIMIT=
# TIER_STANDARD_PER_USER=
# TIER_PREMIUM_LIMIT=
# TIER_PREMIUM_PER_USER=
# TIER_VIP_LIMIT=
# TIER_VIP_PER_USER=

# ---- Optional: integrations ----
# DONUTSMP_API_KEY=

# ---- Optional: tuning (all have sensible defaults if omitted) ----
# STOCK_TICK_INTERVAL_MINUTES=10
# STOCK_SELL_COOLDOWN_MINUTES=
# ROLE_REFRESH_INTERVAL_HOURS=24
# BOT_MONITOR_INTERVAL_MS=120000
# DISCORD_GIVEAWAY_TICK_SECONDS=30
# DISCORD_VOICE_TICK_SECONDS=60
# POINTS_MESSAGE_CHANNEL_IDS=
